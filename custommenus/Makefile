.PHONY: all clean

CXX=g++-10
SDIR=src
ODIR=obj

SRCS=$(wildcard $(SDIR)/*.cpp)
OBJS=$(patsubst $(SDIR)/%.cpp, $(ODIR)/%.o, $(SRCS))

# Header dependency target files; generated by g++ with -MMD
DEPS=$(OBJS:%.o=%.d)

WARNINGS=-Wall -Wno-unused-function -Wno-unused-variable -Wno-parentheses -Wno-unknown-pragmas -Wno-sign-compare -Wno-reorder
CXXFLAGS=-std=c++17 -m32 $(WARNINGS) -Iinclude -I$(SDIR) -fPIC -fvisibility=hidden -D_GNU_SOURCE -DMENUS_BUILD_MODULE
LDFLAGS=-m32 -shared -ldl

all: custommenus.so
clean:
	rm -rf $(ODIR) custommenus.so

-include $(DEPS)

custommenus.so: $(OBJS)
	$(CXX) $^ $(LDFLAGS) -o $@

$(ODIR)/%.o: $(SDIR)/%.cpp
	@mkdir -p $(dir $@)
	$(CXX) $(CXXFLAGS) -MMD -c $< -o $@
